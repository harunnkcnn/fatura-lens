{
  "name": "fatura-lens",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source, offline viewer and batch analyzer for Turkish UBL-TR e-Fatura, e-Arşiv and e-İrsaliye XML files.",
  "license": "MIT",
  "type": "module",
  "author": "Harun (https://github.com/harunnkcnn)",
  "repository": {
    "type": "git",
    "url": "https://github.com/harunnkcnn/fatura-lens.git"
  },
  "keywords": [
    "e-fatura",
    "e-arsiv",
    "e-irsaliye",
    "ubl-tr",
    "gib",
    "xml",
    "invoice",
    "turkey",
    "offline"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "fflate": "^0.8.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xslt-polyfill": "^1.0.34"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "typescript": "~5.8.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  }
}
