{
  "name": "fatura-lens",
  "private": true,
  "version": "0.2.0",
  "description": "Open-source, offline batch reader for Turkish e-Fatura, e-Arşiv and e-İrsaliye: XML, ZIP, PDF and photos via the GİB karekod.",
  "license": "MIT",
  "type": "module",
  "author": "Harun (https://github.com/harunnkcnn)",
  "repository": {
    "type": "git",
    "url": "https://github.com/harunnkcnn/fatura-lens.git"
  },
  "keywords": [
    "e-fatura",
    "e-arsiv",
    "e-irsaliye",
    "ubl-tr",
    "gib",
    "xml",
    "invoice",
    "turkey",
    "offline",
    "karekod",
    "qr-code",
    "pdf"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "fflate": "^0.8.2",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xslt-polyfill": "^1.0.34",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
